---
layout: null
permalink: /search.json
---
[
{% assign items = site.wiki | concat: site.pages %}
{% for p in items %}
  {% if p.title and p.url and p.search != false %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "content": {{ p.content
      | strip_html
      | replace: "\n", " "
      | replace: "\r", " "
      | replace: "\t", " "
      | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endif %}
{% endfor %}
]

