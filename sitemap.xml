---
layout: null
search: exclude
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign documents = site.wiki -%}
{%- comment -%} site root lastmod: posts의 updated 우선, 없으면 date {%- endcomment -%}
{%- assign post_dates = "" | split: "" -%}
{%- for post in site.posts -%}
  {%- if post.updated -%}
    {%- assign post_dates = post_dates | push: post.updated -%}
  {%- else -%}
    {%- assign post_dates = post_dates | push: post.date -%}
  {%- endif -%}
{%- endfor -%}
{%- assign site_lastmod = post_dates | sort | last -%}
<url>
  <loc>{{ site.url }}</loc>
  {%- if site_lastmod -%}
  <lastmod>{{ site_lastmod | date_to_xmlschema }}</lastmod>
  {%- endif -%}
  <priority>1.0</priority>
</url>
{%- comment -%} wiki + posts를 lastmod 기준으로 최신순 정렬 {%- endcomment -%}
{%- assign items = "" | split: "" -%}
{%- for doc in documents -%}
  {%- if doc.public == true and doc.title != 'wiki index' -%}
    {%- if doc.updated -%}{%- assign lm = doc.updated -%}{%- else -%}{%- assign lm = doc.date -%}{%- endif -%}
    {%- capture row -%}{{ lm | date_to_xmlschema }}|{{ site.url }}{{ doc.url }}{%- endcapture -%}
    {%- assign items = items | push: row -%}
  {%- endif -%}
{%- endfor -%}
{%- for post in site.posts -%}
  {%- if post.updated -%}{%- assign lm = post.updated -%}{%- else -%}{%- assign lm = post.date -%}{%- endif -%}
  {%- capture row -%}{{ lm | date_to_xmlschema }}|{{ site.url }}{{ post.url }}{%- endcapture -%}
  {%- assign items = items | push: row -%}
{%- endfor -%}
{%- assign items_sorted = items | sort | reverse -%}
{%- for row in items_sorted -%}
  {%- assign p = row | split: "|" -%}
  {%- assign lm_iso = p[0] -%}
  {%- assign loc = p[1] -%}
<url>
  <loc>{{ loc }}</loc>
  <lastmod>{{ lm_iso }}</lastmod>
</url>
{%- endfor -%}
</urlset>
